# .env로 복사한 후 본인의 값을 입력하세요. 이 예제에는 실제 키를 넣지 않습니다.
TMAP_APP_KEY=
PUBLIC_DATA_KEY=
# 시내버스 노선·정류소·도착 전용 키. 비워두면 기존 PUBLIC_DATA_KEY를 사용합니다.
# 다른 계정의 공용 키를 보존하면서 본인 계정에서 승인받은 키를 여기에 입력합니다.
TAGO_API_KEY=
# ITX 조회·시간표 수집 전용 키. 비워두면 기존 TAGO_API_KEY를 사용합니다.
TRAIN_API_KEY=
# TAGO 시외버스정보 활용신청 승인 필요. 비워두면 PUBLIC_DATA_KEY를 사용합니다.
INTERCITY_DATA_KEY=
# 통학 준비: 아래 두 서비스를 공공데이터포털에서 각각 활용신청하세요.
# 기상청_단기예보 조회서비스 / 한국환경공단_에어코리아_대기오염정보
# 비워 두면 기존 PUBLIC_DATA_KEY를 사용합니다. 인증키의 서비스별 승인 확인이 필요합니다.
WEATHER_DATA_KEY=
AIRKOREA_DATA_KEY=
# 두 캠퍼스 공통의 춘천 참고 측정소이며 캠퍼스 현장 측정값이 아닙니다.
AIRKOREA_STATION_NAME=중앙로
NAVER_MAP_CLIENT_ID=
# 선택 사항. 전처리 노트북의 서버용 네이버 주소 좌표 변환에 사용합니다.
NAVER_GEOCODING_CLIENT_ID=
NAVER_GEOCODING_CLIENT_SECRET=
APP_DEBUG=false
PORT=5050
# 자체 실행한 MOTIS 서버. 예: http://127.0.0.1:8889
MOTIS_BASE_URL=

# Chat only. Generate one fixed secret (at least 32 bytes), different from API keys.
# Never commit the real value. All workers must use the same value.
FLASK_SECRET_KEY=
RIDE_ROOM_DB_PATH=instance/ride_rooms.sqlite3
# false is permitted only for local HTTP. HTTPS deployments must use true.
SESSION_COOKIE_SECURE=false
TAXI_CACHE_TTL_SECONDS=60
TAXI_CACHE_MAX_ENTRIES=512
RIDE_ROOM_MESSAGE_RATE_PER_MINUTE=15
RIDE_ROOM_CREATE_RATE_PER_HOUR=3
