# .env로 복사한 후 본인의 값을 입력하세요. 이 예제에는 실제 키를 넣지 않습니다.
TMAP_APP_KEY=
PUBLIC_DATA_KEY=
NAVER_MAP_CLIENT_ID=
APP_DEBUG=false
PORT=5000

# Chat only. Generate one fixed secret (at least 32 bytes), different from API keys.
# Never commit the real value. All workers must use the same value.
FLASK_SECRET_KEY=
RIDE_ROOM_DB_PATH=instance/ride_rooms.sqlite3
# false is permitted only for local HTTP. HTTPS deployments must use true.
SESSION_COOKIE_SECURE=false
TAXI_CACHE_TTL_SECONDS=60
TAXI_CACHE_MAX_ENTRIES=512
RIDE_ROOM_MESSAGE_RATE_PER_MINUTE=15
RIDE_ROOM_CREATE_RATE_PER_HOUR=3
